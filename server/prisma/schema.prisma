// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
 

model User {
  id          Int @id @default(autoincrement())
  name        String
  email       String @unique
  password    String
  recipes     Recipe[]
}

model Recipe {
  idMeal                Int @id
  strMeal               String
  recipeIngredients     String
  recipeMeasurements    String
  strInstructions       String
  strMealThumb          String?
  recipeCategory        String?
  userRecipeBool        Boolean @default(false)
  userID                Int
  user                  User @relation(fields: [userID], references: [id])
}
